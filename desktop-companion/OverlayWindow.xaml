<Window x:Class="TicketToss.Companion.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" Topmost="True" ShowActivated="False">
    <Grid x:Name="Stage" IsHitTestVisible="False">
        <Image x:Name="TicketImage" Width="670" Height="350" Opacity="0"
               HorizontalAlignment="Center" VerticalAlignment="Center"
               Stretch="Uniform" SnapsToDevicePixels="True" RenderTransformOrigin="0.5,0.5">
            <Image.RenderTransform>
                <TransformGroup>
                    <ScaleTransform x:Name="TicketScale" ScaleX="1" ScaleY="1"/>
                    <RotateTransform x:Name="TicketRotation"/>
                    <TranslateTransform x:Name="TicketTranslation"/>
                </TransformGroup>
            </Image.RenderTransform>
        </Image>
    </Grid>
</Window>
